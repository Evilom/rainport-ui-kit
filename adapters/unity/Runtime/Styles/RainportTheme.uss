@import url("RainportTokens.uss");

/* Rainport public component classes. Keep the rp- prefix in project overrides. */

.rp-root {
    flex-grow: 1;
    padding-left: 28px;
    padding-top: 24px;
    padding-right: 28px;
    padding-bottom: 32px;
    color: var(--rp-ink);
    background-color: var(--rp-paper);
    -unity-font-definition: url("project://database/Packages/com.rainport.ui/Runtime/Fonts/NotoSansSC-Variable.ttf");
    font-size: 18px;
}

.rp-toolbar {
    min-height: 68px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 18px;
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/panel_night.png");
    -unity-slice-left: 18;
    -unity-slice-top: 18;
    -unity-slice-right: 26;
    -unity-slice-bottom: 26;
}

.rp-brand {
    color: var(--rp-white);
    -unity-font-definition: url("project://database/Packages/com.rainport.ui/Runtime/Fonts/ZCOOLKuaiLe-Regular.ttf");
    font-size: 25px;
}

.rp-kicker {
    margin-top: 18px;
    margin-bottom: 6px;
    color: var(--rp-danger);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rp-display {
    color: var(--rp-ink);
    -unity-font-definition: url("project://database/Packages/com.rainport.ui/Runtime/Fonts/ZCOOLKuaiLe-Regular.ttf");
    font-size: 54px;
    white-space: normal;
}

.rp-copy {
    max-width: 760px;
    margin-top: 10px;
    margin-bottom: 18px;
    color: var(--rp-muted);
    font-size: 17px;
    white-space: normal;
}

.rp-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.rp-card {
    min-width: 260px;
    min-height: 160px;
    flex-grow: 1;
    margin-right: 16px;
    margin-bottom: 16px;
    padding-left: 22px;
    padding-top: 22px;
    padding-right: 28px;
    padding-bottom: 28px;
    color: var(--rp-ink);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/panel_paper.png");
    -unity-slice-left: 18;
    -unity-slice-top: 18;
    -unity-slice-right: 26;
    -unity-slice-bottom: 26;
}

.rp-card--selected {
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/panel_signal.png");
}

.rp-card--night {
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/panel_night.png");
}

.rp-card__title {
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Packages/com.rainport.ui/Runtime/Fonts/ZCOOLKuaiLe-Regular.ttf");
    font-size: 29px;
}

.rp-card__meta {
    margin-top: 14px;
    padding-top: 9px;
    border-top-width: 2px;
    border-top-color: var(--rp-ink);
    color: var(--rp-muted);
    font-size: 13px;
    -unity-font-style: bold;
}

.rp-button {
    min-width: 160px;
    min-height: 58px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding-left: 22px;
    padding-right: 28px;
    color: var(--rp-ink);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_signal.png");
    -unity-slice-left: 18;
    -unity-slice-top: 14;
    -unity-slice-right: 24;
    -unity-slice-bottom: 22;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    -unity-font-style: bold;
    font-size: 17px;
    transition-property: translate;
    transition-duration: 0.12s;
}

.rp-button:hover {
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_signal_hover.png");
    -unity-slice-right: 26;
    -unity-slice-bottom: 24;
    translate: -2px -2px;
}

.rp-button:active {
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_signal_pressed.png");
    -unity-slice-left: 20;
    -unity-slice-top: 16;
    -unity-slice-right: 20;
    -unity-slice-bottom: 18;
    translate: 3px 3px;
}

.rp-button--night {
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_night.png");
}

.rp-button--danger {
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_danger.png");
}

.rp-button:disabled {
    color: var(--rp-paper-deep);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/button_disabled.png");
    opacity: 0.75;
}

.rp-alert {
    min-height: 84px;
    margin-top: 12px;
    padding-left: 78px;
    padding-top: 20px;
    padding-right: 24px;
    padding-bottom: 24px;
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/alert_danger.png");
    -unity-slice-left: 72;
    -unity-slice-top: 16;
    -unity-slice-right: 20;
    -unity-slice-bottom: 24;
    -unity-font-style: bold;
}

.rp-tag {
    min-width: 96px;
    min-height: 38px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 18px;
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/tag_signal.png");
    -unity-slice-left: 14;
    -unity-slice-top: 12;
    -unity-slice-right: 20;
    -unity-slice-bottom: 18;
    -unity-font-style: bold;
    font-size: 13px;
}

.rp-tag--danger {
    color: var(--rp-white);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/tag_danger.png");
}

.rp-stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.rp-stat {
    min-width: 150px;
    margin-right: 9px;
    margin-bottom: 9px;
    padding-left: 14px;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    color: var(--rp-white);
    background-color: var(--rp-blue);
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: var(--rp-ink);
    border-top-color: var(--rp-ink);
    border-right-color: var(--rp-ink);
    border-bottom-color: var(--rp-ink);
}

.rp-stat__value {
    -unity-font-definition: url("project://database/Packages/com.rainport.ui/Runtime/Fonts/ZCOOLKuaiLe-Regular.ttf");
    font-size: 34px;
}

.rp-meter {
    height: 20px;
    margin-top: 6px;
    margin-bottom: 12px;
    padding-left: 3px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    background-color: var(--rp-white);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--rp-ink);
    border-top-color: var(--rp-ink);
    border-right-color: var(--rp-ink);
    border-bottom-color: var(--rp-ink);
}

.rp-meter__fill {
    width: 67%;
    height: 100%;
    background-color: var(--rp-rain);
}

.rp-receipt {
    width: 310px;
    min-height: 350px;
    padding-left: 34px;
    padding-top: 34px;
    padding-right: 42px;
    padding-bottom: 48px;
    color: var(--rp-ink);
    background-image: url("project://database/Packages/com.rainport.ui/Runtime/Assets/1x/receipt_paper.png");
    -unity-slice-left: 26;
    -unity-slice-top: 28;
    -unity-slice-right: 30;
    -unity-slice-bottom: 42;
}
